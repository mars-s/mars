# Optional Mac/local Next development connection. Server-only, never NEXT_PUBLIC.
# Use the private Pi origin and workspace token from your sign-in link.
MARS_PI_ORIGIN=
MARS_PI_TOKEN=
# Direct workspace development uses loopback3082 by default.
MARS_UI_PORT=3082
# Optional exact private proxy origin for Next development assets and HMR.
MARS_PUBLIC_ORIGIN=
