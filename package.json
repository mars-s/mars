{
  "name": "mars",
  "version": "0.1.0",
  "private": true,
  "description": "Pi Durable with the Mars web workspace.",
  "workspaces": [
    "apps/ui",
    "packages/pi-host"
  ],
  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "preinstall": "node scripts/check-runtime.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/run.mjs development",
    "start": "node scripts/run.mjs production",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/check-syntax.mjs && npm run typecheck --workspace mars-ui",
    "lint": "npm run lint --workspace mars-ui",
    "test": "npm run test:scripts && npm test --workspace mars-ui && npm run check --workspace @mars/pi-host",
    "test:install": "node --test scripts/test-install.mjs",
    "test:ui": "npm run test:ui --workspace mars-ui",
    "architecture:check": "node scripts/check-boundaries.mjs",
    "verify": "npm run architecture:check && npm run typecheck && npm run lint && npm test && npm run build",
    "install:service": "node scripts/install-service.mjs",
    "test:smoke": "node scripts/smoke-install.mjs",
    "test:scripts": "node scripts/run-script-tests.mjs",
    "host:deploy": "node scripts/deploy-host.mjs",
    "update": "node scripts/update.mjs"
  }
}
