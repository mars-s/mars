{
  "name": "mars",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "dev:desktop": "concurrently -k -n gateway,desktop -c magenta,cyan \"pnpm --filter @mars/gateway dev\" \"pnpm --filter @mars/desktop dev\"",
    "dev:gateway": "pnpm --filter @mars/gateway dev",
    "dev:ui": "pnpm --filter @mars/desktop dev",
    "build": "pnpm --filter @mars/gateway build && pnpm --filter @mars/desktop build",
    "typecheck": "pnpm --filter @mars/gateway typecheck && pnpm --filter @mars/desktop typecheck",
    "legacy:zcode:desktop": "node scripts/dev-desktop-env.mjs production",
    "legacy:zcode:web": "concurrently -k -n server,web -c blue,green \"pnpm --filter @zcode/server dev\" \"pnpm --filter @zcode/web dev\"",
    "legacy:zcode:build": "pnpm -r --filter '!@mars/gateway' --filter '!@mars/desktop' build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
