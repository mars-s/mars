# Mars local headless gateway
MARS_GATEWAY_HOST=127.0.0.1
MARS_GATEWAY_PORT=3037
MARS_WORKSPACE=

# Optional: preconfigure OpenCode Go instead of entering the key in the desktop setup screen.
MARS_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
MARS_MODEL_ID=gpt-5.6-luna
MARS_API_KEY=

# Remote mode is intentionally a placeholder for now. The desktop already talks to the gateway
# over HTTP + WebSocket so the same protocol can be moved to a Linux host later.
