# Deployment overrides. Copy to .env as needed; production overrides can also go
# in the untracked .env.local.
#
# There is NO built-in default for any of these. Every one is empty on purpose:
# this fork has removed the vendor endpoints, so an unconfigured build resolves an
# empty origin and refuses to make the call, rather than quietly reaching a host
# you did not choose. Point them at your own deployment.
ZCODE_BASE_URL=
BIGMODEL_API_BASE_URL=
ZAI_OAUTH_ORIGIN=
ZAI_BUSINESS_BASE_URL=
# The public OAuth client id is not a secret, but it is the vendor's. Supply your
# own registration if you run an OAuth provider at all.
ZAI_OAUTH_CLIENT_ID=

# No built-in asset origin. Empty means "no remote asset origin configured", and
# the app will not contact any third-party host: development uses the local mock
# CDN, and a packaged build fails with an explicit error instead of silently
# reaching someone else's server. Point these three at your own origin when you
# need remote assets (the official marketplace catalog, store icons, release
# packages).
# Remote release asset base URL, for example https://your-host/zcode/electron/releases
ZCODE_CDN_BASE_URL=
# Full remote asset override URL. It must include the version that matches the
# running build. Empty means it is derived from ZCODE_CDN_BASE_URL.
ZCODE_REMOTE_ASSET_CDN_BASE_URL=
# Official plugin marketplace source (the marketplace.json URL, or an owner/repo
# git shorthand). Empty means the official marketplace keeps only the local
# built-in plugins; the plugin store itself still works and personal sources are
# unaffected.
ZCODE_OFFICIAL_MARKETPLACE_SOURCE=
# Official store icon asset base URL. Empty means listings fall back to the
# default placeholder image.
ZCODE_OFFICIAL_PLUGIN_ASSETS_BASE_URL=

# Base URL that imported sessions link back to. This does not change the API.
# Keep the /cn/share path and do not include a share code. When you change the
# API origin, change this to match, or delete the entry so it follows the API
# origin automatically. Do not assign it an empty value.
ZCODE_CONVERSATION_SHARE_WEB_URL=

# Optional path to a local provider config file. Empty uses the built-in config.
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# Intranet or private deployment addresses have no online default. Fill these in
# explicitly as needed.
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
