# Copy to .env for npm scripts. Data and credentials stay outside the checkout.
# MARS_PI_ROOT=/absolute/private/path/mars
MARS_PI_PORT=3081
MARS_UI_PORT=3082
# Explicit origin for an existing private reverse proxy, without a trailing slash.
# MARS_PUBLIC_ORIGIN=https://your-private-host.example
# Optional comma-separated proxy aliases retained during migration.
# MARS_ALLOWED_ORIGINS=https://your-old-private-host.example:9443
# Optional service names when retaining an existing installation.
# MARS_HOST_SERVICE=mars-pi-host.service
# MARS_UI_SERVICE=mars-pi-ui.service
# Required util-linux-compatible flock executable, normally found through PATH.
# MARS_FLOCK_PATH=/absolute/path/to/flock
